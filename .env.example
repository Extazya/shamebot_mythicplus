# Token du bot (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# Application ID (Discord Developer Portal → General Information)
CLIENT_ID=

# Optionnel : enregistre les commandes sur un seul serveur (instantané) au lieu de globalement (~1h)
GUILD_ID=

# Optionnel : emplacement de la base JSON (défaut : data/db.json)
# DB_PATH=/var/lib/mplus-bot/db.json
